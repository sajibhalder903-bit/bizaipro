NODE_ENV=production
PORT=3000
SITE_URL=https://bizaipro.com
MONGODB_URI=mongodb://127.0.0.1:27017/bizaipro
SESSION_SECRET=replace-with-at-least-48-random-characters
# Set the number of trusted reverse proxies to match your hosting topology.
TRUST_PROXY=1
# A persistent directory, retained between deployments, is required for images.
UPLOAD_DIR=./uploads
# Keep false for staging. Set true only on the production domain after migration QA.
ALLOW_INDEXING=false
